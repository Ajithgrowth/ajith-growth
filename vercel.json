{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/legacy-admin", "destination": "/legacy-admin/index.html" },
    { "source": "/legacy-admin/", "destination": "/legacy-admin/index.html" },
    { "source": "/legacy-admin/(.*)", "destination": "/legacy-admin/$1" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
